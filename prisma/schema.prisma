// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["fullTextSearchPostgres", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                @id @default(cuid())
  name                      String?
  email                     String                @unique
  password                  String?
  phoneNumber               String?               @unique
  role                      Role                  @default(USER)
  isActive                  Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  lastLoginAt               DateTime?
  profilePicture            String?
  failedLoginAttempts       Int                   @default(0)
  lockedUntil               DateTime?
  addresses                 Address[]
  reviews                   Review[]
  cart                      Cart?
  order                     Order[]
  authProvider              AuthProvider[]
  auditLog                  AuditLog[]
  wishlist                  WishList?
  refreshTokens             RefreshToken[]
  passwordResetToken        String?
  passwordResetTokenExp     DateTime?
  emailVerifiedAt           DateTime?
  pendingEmail              String?
  emailVerificationToken    String?               @unique
  emailVerificationTokenExp DateTime?
  redemptions               Redemption[]
  customerGroups            CustomerGroupMember[]
  returnRequests            ReturnRequest[]
  storeMemberships          StoreMembership[]
  /// TOTP secret (base32), AES-256-GCM encrypted with MFA_ENCRYPTION_KEY; set at enrolment start
  mfaSecret                 String?
  /// Set once the first code confirmed enrolment; MFA is active only from then
  mfaEnabledAt              DateTime?
  /// Last accepted TOTP time step; codes for this step or earlier are replays
  mfaLastUsedStep           Int?
  mfaRecoveryCodes          MfaRecoveryCode[]
}

/// Single-use MFA recovery code, stored as a keyed hash (src/iam/mfa/mfa-crypto.ts).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthProvider {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model Address {
  id            String       @id @default(cuid())
  // Nullable only for addresses saved before they existed; the API requires them and checkout refuses without them.
  recipientName String?
  phone         String?
  region        GhanaRegion?
  street        String
  city          String
  area          String?
  landmark      String?
  ghanaPostGps  String?
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  zipCode       String?
  country       String
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Order         Order[]

  @@index([userId])
}

enum GhanaRegion {
  AHAFO
  ASHANTI
  BONO
  BONO_EAST
  CENTRAL
  EASTERN
  GREATER_ACCRA
  NORTH_EAST
  NORTHERN
  OTI
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  VOLTA
  WESTERN
  WESTERN_NORTH
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?       @db.Text
  image         String?
  products      Product[]
  subcategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  promotions    Promotion[]
}

model SubCategory {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  image       String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, categoryId])
}

model Brand {
  id          String      @id @default(cuid())
  name        String      @unique @db.VarChar(255)
  description String?     @db.Text
  logo        String?
  products    Product[]
  promotions  Promotion[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// The SKU: the unit that is priced, stocked and sold (ADR-0003). Every product has at least one.
model Variant {
  id                String             @id @default(cuid())
  sku               String             @unique
  barcode           String?            @unique
  /// Values for the product type's variant axes (ADR-0002), checked by product-types/domain/attribute-validation.ts
  optionValues      Json               @default("{}")
  /// Canonical form of optionValues (attribute-validation.ts), unique per product among active variants
  optionsKey        String             @default("")
  /// Null only for a legacy product migrated without a price (its variant is archived until priced)
  price             Decimal?           @db.Decimal(14, 2)
  /// Admin-entered price before tax; price is basePrice with tax added when the product is taxable
  basePrice         Decimal?           @db.Decimal(14, 2)
  isActive          Boolean            @default(true)
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  image             String?
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItem          CartItem[]
  orderItem         OrderItem[]
  promotions        Promotion[]
  lowStockThreshold Int?               @default(5)
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  priceChanges      PriceChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, optionsKey], where: raw("\"isActive\""))
  @@index([productId])
}

/// A kind of product (ADR-0002) owning the attribute definitions its products and variants are validated against.
/// System types are seeded by migration and immutable.
model ProductType {
  id          String                @id @default(cuid())
  key         String                @unique @db.VarChar(50)
  name        String                @db.VarChar(100)
  description String?               @db.VarChar(500)
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  attributes  AttributeDefinition[]
  products    Product[]
}

model AttributeDefinition {
  id            String            @id @default(cuid())
  productTypeId String
  key           String            @db.VarChar(50)
  label         String            @db.VarChar(100)
  dataType      AttributeDataType
  /// Unit of a NUMBER attribute's values, e.g. "g" or "ml"
  unit          String?           @db.VarChar(20)
  isRequired    Boolean           @default(false)
  /// Empty means any value of the data type
  allowedValues String[]
  /// Variant axes are set per variant (optionValues); the others per product (attributes)
  isVariantAxis Boolean           @default(false)
  isFilterable  Boolean           @default(false)
  position      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  productType   ProductType       @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([productTypeId, key])
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
}

enum FulfilmentKind {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum UnitOfMeasure {
  EACH
  KG
  G
  L
  ML
  M
}

model Product {
  id String @id @default(cuid())

  name             String  @db.VarChar(255)
  description      String? @db.Text
  shortDescription String? @db.VarChar(500)

  // Price, stock, SKU and barcode live on the variants (ADR-0003).
  currency  Currency? @default(GHS)
  /// Variant prices add tax to their basePrice when true
  isTaxable Boolean   @default(false)

  images      String[]
  attachments String[]

  isActive    Boolean        @default(true)
  status      ProductStatus? @default(DRAFT)
  publishedAt DateTime?

  deliveryOptions         DeliveryOptions[] @default([LOCAL_DELIVERY])
  selectedDeliveryRegions String[]

  expiryDate DateTime?

  /// Defaults to the seeded General type
  productTypeId String      @default("product_type_general")
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  /// Values for the product type's non-axis attributes (ADR-0002), checked by attribute-validation.ts
  attributes    Json        @default("{}")

  // Capability columns (ADR-0002 option 4): typed because checkout, inventory, delivery or compliance will branch on them.
  requiresPrescription Boolean        @default(false)
  isPerishable         Boolean        @default(false)
  shelfLifeDays        Int?
  trackLots            Boolean        @default(false)
  trackSerials         Boolean        @default(false)
  fulfilmentKind       FulfilmentKind @default(PHYSICAL)
  unitOfMeasure        UnitOfMeasure  @default(EACH)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   SubCategory? @relation(fields: [subcategoryId], references: [id])
  tags          Tag[]
  reviews       Review[]
  variants      Variant[]
  promotions    Promotion[]
  cartItem      CartItem[]
  orderItem     OrderItem[]
  wishlist      WishList[]
  brand         Brand?       @relation(fields: [brandId], references: [id])
  brandId       String?

  @@index([brandId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive, status])
  @@index([productTypeId])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Currency {
  GHS
  USD
  EUR
  GBP
  NGN
}

enum DeliveryOptions {
  LOCAL_DELIVERY
  INTERNATIONAL_DELIVERY
  SELECTED_REGIONS
}

model Review {
  id        String    @id @default(cuid())
  score     Int
  comment   String?
  productId String
  userId    String
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  /// The variant's product, kept for lookups by product (a variant never changes product)
  productId     String
  variantId     String
  quantity      Int      @default(1)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  originalPrice Decimal? @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                      String             @id @default(cuid())
  orderNumber             Int                @unique
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency                Currency
  /// 1 for orders priced and snapshotted by createOrder since P1-O.1; 0 for older orders, whose totals are copied
  /// from what they stored (null where unknown) and which have no tax lines
  pricingVersion          Int
  /// Sum of unit list price x quantity, before any discount (prices include tax)
  subtotal                Decimal?           @db.Decimal(14, 2)
  /// Every discount: product discounts and the coupon (the negated sum of the adjustments)
  discountTotal           Decimal?           @db.Decimal(14, 2)
  /// Tax included in the line totals (the sum of the line taxes)
  taxTotal                Decimal?           @db.Decimal(14, 2)
  shippingTotal           Decimal?           @db.Decimal(14, 2)
  /// The amount charged: subtotal - discountTotal + shippingTotal
  grandTotal              Decimal            @db.Decimal(14, 2)
  status                  OrderStatus        @default(PLACED)
  fulfillmentType         FulfillmentType    @default(DELIVERY)
  shippingAddressId       String?
  shippingAddress         Address?           @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  pickupLocationId        String?
  pickupLocation          PickupLocation?    @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  shippingAddressSnapshot Json?
  pickupLocationSnapshot  Json?
  /// The coupon code entered at checkout
  couponCodeId            String?
  couponCode              CouponCode?        @relation(fields: [couponCodeId], references: [id])
  paymentMethod           PaymentMethod      @default(ONLINE)
  contactEmail            String
  contactPhone            String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deleted                 Boolean            @default(false)
  deletedAt               DateTime?
  items                   OrderItem[]
  adjustments             OrderAdjustment[]
  redemptions             Redemption[]
  paymentIntent           PaymentIntent?
  cashCollections         CashCollection[]
  returnRequests          ReturnRequest[]
  stockReservations       StockReservation[]
  shipments               Shipment[]
  statusEvents            OrderStatusEvent[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String             @id @default(cuid())
  orderId       String
  productId     String
  variantId     String
  /// Product name when ordered (orders placed before P1-O.1 copy the name the product had when migrated)
  productName   String
  /// Snapshot of the variant's SKU and option values when ordered (null on lines ordered before P1-V.3)
  sku           String?
  optionValues  Json?
  quantity      Int                @default(1)
  /// Catalogue price of one unit when ordered, tax included
  unitListPrice Decimal            @db.Decimal(14, 2)
  /// Product discount taken off one unit
  unitDiscount  Decimal            @db.Decimal(14, 2)
  /// One unit after its discount, without tax; null on orders placed before P1-O.1 (tax unknown)
  unitNet       Decimal?           @db.Decimal(14, 2)
  /// Tax included in one discounted unit; null on orders placed before P1-O.1
  unitTax       Decimal?           @db.Decimal(14, 2)
  /// (unitListPrice - unitDiscount) x quantity, which is (unitNet + unitTax) x quantity
  lineTotal     Decimal            @db.Decimal(14, 2)
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       Variant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  reservations  StockReservation[]
  adjustments   OrderAdjustment[]
  taxLines      OrderLineTax[]

  @@index([orderId])
  @@index([productId, orderId])
  @@index([variantId])
}

/// A promotion taken off an order (ADR-0005 adjustments), signed: reductions are negative. Line-level when orderItemId
/// is set (already reflected in that line's unitDiscount), order-level otherwise. DISCOUNT for an automatic promotion,
/// COUPON for one a coupon code unlocked.
model OrderAdjustment {
  id          String              @id @default(cuid())
  orderId     String
  orderItemId String?
  type        OrderAdjustmentType
  /// The Promotion id it came from (kept when the promotion is later deleted)
  sourceId    String?
  /// The coupon code that unlocked it, when ordered
  code        String?
  amount      Decimal             @db.Decimal(14, 2)
  createdAt   DateTime            @default(now())
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
}

enum OrderAdjustmentType {
  DISCOUNT
  COUPON
}

/// One tax included in an order line, as the pricing at placement computed it (ADR-0006 snapshot; never recomputed).
model OrderLineTax {
  id          String    @id @default(cuid())
  orderItemId String
  /// The Tax row it came from (kept when the tax is later changed or deleted)
  taxId       String?
  name        String
  rate        Decimal   @db.Decimal(9, 6)
  /// The line's amount without tax that the rate applies to
  base        Decimal   @db.Decimal(14, 2)
  amount      Decimal   @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model PaymentIntent {
  id        String              @id @default(cuid())
  orderId   String              @unique
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount    Decimal             @db.Decimal(14, 2)
  currency  String              @default("GHS")
  status    PaymentIntentStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  attempts  PaymentAttempt[]
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  intentId         String
  intent           PaymentIntent        @relation(fields: [intentId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  reference        String?              @unique
  amount           Decimal              @db.Decimal(14, 2)
  currency         String               @default("GHS")
  status           PaymentStatus        @default(PENDING)
  rawStatus        String?
  reviewReason     PaymentReviewReason?
  channel          String
  providerDetails  Json?
  idempotencyKey   String?
  authorizationUrl String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deleted          Boolean              @default(false)
  deletedAt        DateTime?
  refunds          Refund[]
  cashCollection   CashCollection?

  @@unique([intentId, idempotencyKey])
  @@index([intentId])
  @@index([status, createdAt])
}

model Refund {
  id              String         @id @default(cuid())
  attemptId       String
  attempt         PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  amount          Decimal        @db.Decimal(14, 2)
  /// Tax included in the amount, read from the order's stored tax lines in proportion; null when the order has no
  /// tax snapshot (placed before P1-O.1) or the refund returns a charge that never paid the order
  taxAmount       Decimal?       @db.Decimal(14, 2)
  currency        String         @default("GHS")
  status          RefundStatus   @default(PENDING)
  providerRef     String?        @unique
  failureReason   String?
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([attemptId])
  @@index([status])
}

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventKey    String
  event       String
  reference   String?
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  attempts    Int             @default(0)
  lastError   String?

  @@unique([provider, eventKey])
  @@index([processedAt, receivedAt])
}

model CashCollection {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptId    String?         @unique
  attempt      PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  riderId      String?
  recordedById String?
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("GHS")
  collectedAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([orderId])
}

model WishList {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Transactional outbox (ADR-0009): written in the same transaction as the state change, published to BullMQ by the
/// worker's relay. `type` is a versioned event name such as `order.placed.v1`.
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  /// The request that recorded the event; the relay passes it to the job so worker logs correlate.
  requestId   String?

  @@index([publishedAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

/// A payment attempt: CANCELLED when superseded by a newer attempt or its order closed (a late provider verdict can
/// still settle it), FAILED when the provider refused it.
enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  CANCELLED
}

/// The order's payment machine (src/payment/payment-intent-status.ts).
enum PaymentIntentStatus {
  PENDING
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentReviewReason {
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  ORDER_NOT_PAYABLE
  ALREADY_PAID
}

enum PaymentProvider {
  PAYSTACK
  CASH_ON_DELIVERY
}

enum RefundStatus {
  PENDING
  SENDING
  PROCESSED
  FAILED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
}

/// The order machine (src/order/order-status.ts).
enum OrderStatus {
  PLACED
  CONFIRMED
  IN_FULFILMENT
  COMPLETED
  CANCELLED
  EXPIRED
  PAYMENT_REVIEW
}

/// The fulfilment machine of a shipment (src/order/shipment-status.ts).
enum ShipmentStatus {
  PENDING
  PICKING
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
}

/// Goods of an order on their way to the customer. One per order for now (created on the first fulfilment step); the
/// schema allows several for partial fulfilment later.
model Shipment {
  id             String                @id @default(cuid())
  orderId        String
  status         ShipmentStatus        @default(PENDING)
  carrier        String?
  trackingNumber String?
  /// When it went out for delivery or became ready for pickup (null on shipments migrated without that date)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events         ShipmentStatusEvent[]

  @@index([orderId])
}

/// The order's status history, written in the same transaction as every transition; the customer's tracking timeline.
model OrderStatusEvent {
  id        String       @id @default(cuid())
  orderId   String
  /// Null for the first event (the order was placed, or migrated)
  from      OrderStatus?
  to        OrderStatus
  /// The staff member or customer who caused it; null for the system (payment, expiry)
  actorId   String?
  reason    String?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ShipmentStatusEvent {
  id         String          @id @default(cuid())
  shipmentId String
  from       ShipmentStatus?
  to         ShipmentStatus
  actorId    String?
  reason     String?
  createdAt  DateTime        @default(now())
  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String
  reason       String       @db.Text
  status       ReturnStatus @default(PENDING)
  refundAmount Decimal?     @db.Decimal(14, 2)
  adminNote    String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  refund       Refund?
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model PickupLocation {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  country   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([isActive])
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String   @unique
  cities    String[]
  fee       Decimal  @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Store {
  id               String            @id @default(cuid())
  singleton        Boolean           @unique @default(true)
  legalName        String
  tradingName      String
  tin              String?
  vatRegistered    Boolean           @default(false)
  pricesIncludeTax Boolean           @default(true)
  currency         Currency          @default(GHS)
  supportEmail     String?
  supportPhone     String?
  nextOrderNumber  Int               @default(10001)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      StoreMembership[]
  stockLocations   StockLocation[]
}

/// A staff role (ADR-0013). Permissions are code constants (src/iam/authorization/permissions.ts); system roles are
/// seeded by migration and immutable. Named StaffRole so it does not clash with the legacy Role enum.
model StaffRole {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  permissions String[]
  isSystem    Boolean           @default(false)
  mfaRequired Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships StoreMembership[]
}

/// A user's staff role in the store. Customers have none; one per user per store.
model StoreMembership {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  roleId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  role      StaffRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, storeId])
  @@index([roleId])
}

model Tax {
  id        String   @id @default(cuid())
  name      String   @unique
  rate      Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockLocationType {
  WAREHOUSE
  BRANCH
  PICKUP_POINT
}

/// Where stock is held (ADR-0008). Each store has exactly one default location, created by migration; all stock lives
/// there until fulfilment picks locations by rule.
model StockLocation {
  id           String             @id @default(cuid())
  storeId      String
  name         String
  type         StockLocationType  @default(WAREHOUSE)
  isActive     Boolean            @default(true)
  isDefault    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  store        Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  levels       StockLevel[]
  reservations StockReservation[]
  movements    StockMovement[]

  @@unique([storeId], map: "StockLocation_one_default_per_store", where: raw("\"isDefault\""))
}

/// Stock of one variant (SKU) at one location. available = onHand - reserved. The database rejects a negative onHand
/// or reserved and reserved > onHand; every change writes a StockMovement in the same transaction.
model StockLevel {
  id         String        @id @default(cuid())
  variantId  String
  locationId String
  onHand     Int           @default(0)
  reserved   Int           @default(0)
  version    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  variant    Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([locationId])
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

/// Stock held for an order line. ACTIVE counts in StockLevel.reserved; CONSUMED has left onHand (payment or dispatch);
/// RELEASED has gone back (cancel or expiry). Each transition is a conditional update on the status.
model StockReservation {
  id          String                 @id @default(cuid())
  variantId   String
  locationId  String
  orderId     String
  orderItemId String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  /// When the unpaid order becomes eligible for expiry; null for cash-on-delivery orders and migrated ones
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  variant     Variant                @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location    StockLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, locationId])
  @@index([orderId])
  @@index([variantId, locationId, status])
}

enum StockMovementReason {
  OPENING_BALANCE
  RECEIPT
  SALE
  RETURN_RESTOCK
  ADJUSTMENT
  TRANSFER
  RESERVE
  RELEASE
}

/// Append-only stock ledger (ADR-0008): one row per StockLevel change, in the same transaction. Per (variant,
/// location), the sum of onHandDelta is onHand and the sum of reservedDelta is reserved. A trigger refuses updates
/// and direct deletes.
model StockMovement {
  id            String              @id @default(cuid())
  variantId     String
  locationId    String
  onHandDelta   Int
  reservedDelta Int                 @default(0)
  reason        StockMovementReason
  /// What caused the movement, e.g. ("Order", orderId) or ("ReturnRequest", returnRequestId)
  refType       String?
  refId         String?
  actorId       String?
  note          String?
  createdAt     DateTime            @default(now())
  variant       Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location      StockLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([locationId])
  @@index([refType, refId])
  @@index([createdAt])
}

enum PriceChangeField {
  PRICE
  BASE_PRICE
}

enum PriceChangeSource {
  ADMIN_EDIT
  VARIANT_CREATED
  TAX_RATE_CHANGE
  MIGRATION
}

/// Append-only price history (ADR-0005 §6): one row per changed Variant.price or basePrice, written in the same
/// transaction as the change. A trigger refuses updates and direct deletes; deleting the variant removes its rows.
model PriceChange {
  id        String            @id @default(cuid())
  variantId String
  field     PriceChangeField
  /// Null for the variant's first price
  oldValue  Decimal?          @db.Decimal(14, 2)
  newValue  Decimal           @db.Decimal(14, 2)
  currency  Currency
  source    PriceChangeSource
  reason    String?
  actorId   String?
  createdAt DateTime          @default(now())
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

/// What a promotion targets (ADR-0005 §2): one kind of target per promotion, or the whole cart.
enum PromotionScope {
  SKU
  PRODUCT
  CATEGORY
  BRAND
  CART
}

/// How a promotion reduces the price.
enum PromotionType {
  /// value is a percentage (0-100) of the price
  PERCENT
  /// value comes off each targeted unit, or off the cart
  AMOUNT_OFF
  /// each targeted unit costs value (never more than its price); not for CART
  FIXED_PRICE
}

/// A price reduction the pricing engine (src/pricing/price.ts) applies while it is active, in its schedule and its
/// conditions hold. With requiresCoupon, only an order that enters one of its coupon codes gets it. Targets: variants
/// for SKU, products for PRODUCT, categories for CATEGORY, brands for BRAND, none for CART.
model Promotion {
  id               String          @id @default(cuid())
  name             String
  description      String?
  scope            PromotionScope
  type             PromotionType
  value            Decimal         @db.Decimal(14, 2)
  /// The order's merchandise must be worth at least this much (the engine says which subtotal)
  minimumSpend     Decimal?        @db.Decimal(14, 2)
  /// At least this many targeted units (any unit for CART) must be in the cart
  minimumQuantity  Int?
  startsAt         DateTime
  /// Open-ended when null
  endsAt           DateTime?
  isActive         Boolean         @default(false)
  /// Breaks ties between equal savings: the lowest number wins, then the oldest promotion
  priority         Int             @default(0)
  /// Within a group, per level (item or cart), only the promotion saving the most applies
  stackingGroup    String          @default("default")
  /// When it applies, no other promotion does
  exclusive        Boolean         @default(false)
  requiresCoupon   Boolean         @default(false)
  /// Orders that may use it, across all customers; null for no limit
  usageLimit       Int?
  /// Reserved redemptions: taken when an order is placed, given back on cancel or expiry before payment
  usedCount        Int             @default(0)
  /// Orders each customer may use it on; null for no limit
  perCustomerLimit Int?
  /// Only for a customer without an earlier order that reached CONFIRMED (or later) or PAYMENT_REVIEW
  firstOrderOnly   Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  variants         Variant[]
  products         Product[]
  categories       Category[]
  brands           Brand[]
  /// Only for members of one of these groups; empty for everyone
  customerGroups   CustomerGroup[]
  couponCodes      CouponCode[]
  redemptions      Redemption[]

  @@index([isActive, startsAt, endsAt])
}

/// A code a customer enters at checkout to unlock its promotion; one per order.
model CouponCode {
  id          String       @id @default(cuid())
  /// Upper case (a CHECK enforces it), so codes are unique ignoring case
  code        String       @unique @db.VarChar(50)
  promotionId String
  isActive    Boolean      @default(true)
  /// Orders that may use this code; null for no limit (the promotion's limits still apply)
  usageLimit  Int?
  usedCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  promotion   Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions Redemption[]
  orders      Order[]

  @@index([promotionId])
}

enum RedemptionStatus {
  /// Counted against the limits since the order was placed
  RESERVED
  /// Given back: the order was cancelled or expired before payment
  RELEASED
}

/// One promotion used by one order (ADR-0005 §5); the limits count RESERVED rows.
model Redemption {
  id           String           @id @default(cuid())
  promotionId  String
  couponCodeId String?
  customerId   String
  orderId      String
  status       RedemptionStatus @default(RESERVED)
  createdAt    DateTime         @default(now())
  releasedAt   DateTime?
  promotion    Promotion        @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  couponCode   CouponCode?      @relation(fields: [couponCodeId], references: [id], onDelete: Restrict)
  customer     User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId, orderId])
  @@index([promotionId, customerId, status])
  @@index([couponCodeId])
  @@index([customerId])
  @@index([orderId])
}

/// A named set of customers (P2-B.3). Generic: promotions may be limited to groups, and B2B price lists (P2-W) will
/// reuse them.
model CustomerGroup {
  id          String                @id @default(cuid())
  name        String                @unique @db.VarChar(100)
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  members     CustomerGroupMember[]
  promotions  Promotion[]
}

/// A customer's membership of a group.
model CustomerGroupMember {
  groupId   String
  userId    String
  createdAt DateTime      @default(now())
  group     CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}
