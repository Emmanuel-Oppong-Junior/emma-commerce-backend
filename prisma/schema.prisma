// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String          @id @default(cuid())
  name                      String?
  email                     String          @unique
  password                  String?
  phoneNumber               String?         @unique
  role                      Role            @default(USER)
  isActive                  Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  lastLoginAt               DateTime?
  profilePicture            String?
  failedLoginAttempts       Int             @default(0)
  lockedUntil               DateTime?
  addresses                 Address[]
  reviews                   Review[]
  cart                      Cart?
  order                     Order[]
  authProvider              AuthProvider[]
  auditLog                  AuditLog[]
  wishlist                  WishList?
  refreshTokens             RefreshToken[]
  passwordResetToken        String?
  passwordResetTokenExp     DateTime?
  emailVerifiedAt           DateTime?
  pendingEmail              String?
  emailVerificationToken    String?         @unique
  emailVerificationTokenExp DateTime?
  couponUsages              CouponUsage[]
  returnRequests            ReturnRequest[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthProvider {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model Address {
  id        String   @id @default(cuid())
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]

  @@index([userId])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?       @db.Text
  image         String?
  products      Product[]
  subcategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  discount      Discount?     @relation(fields: [discountId], references: [id])
  discountId    String?

  @@index([discountId])
}

model SubCategory {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  image       String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, categoryId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(255)
  description String?   @db.Text
  logo        String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Variant {
  id                String         @id @default(cuid())
  size              String?
  color             String?
  quantity          Int            @default(0)
  price             Decimal        @db.Decimal(14, 2)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  cartItem          CartItem[]
  orderItem         OrderItem[]
  discount          Discount?      @relation(fields: [discountId], references: [id])
  discountId        String?
  lowStockThreshold Int?           @default(5)
  inventoryLogs     InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([discountId])
}

model Product {
  id String @id @default(cuid())

  name             String  @db.VarChar(255)
  description      String? @db.Text
  shortDescription String? @db.VarChar(500)

  price        Decimal?  @db.Decimal(14, 2)
  currentPrice Decimal?  @db.Decimal(14, 2)
  currency     Currency? @default(GHS)
  basePrice    Decimal?  @db.Decimal(14, 2)
  isTaxable    Boolean   @default(false)

  sku     String? @unique
  barcode String? @unique

  quantity      Int          @default(0)
  stockStatus   StockStatus? @default(IN_STOCK)
  lowStockAlert Int?         @default(5)

  images      String[]
  attachments String[]

  isActive    Boolean        @default(true)
  status      ProductStatus? @default(DRAFT)
  publishedAt DateTime?

  deliveryOptions         DeliveryOptions[] @default([LOCAL_DELIVERY])
  selectedDeliveryRegions String[]

  expiryDate DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   SubCategory?   @relation(fields: [subcategoryId], references: [id])
  tags          Tag[]
  reviews       Review[]
  variants      Variant[]
  discounts     Discount[]
  cartItem      CartItem[]
  orderItem     OrderItem[]
  wishlist      WishList[]
  brand         Brand?         @relation(fields: [brandId], references: [id])
  brandId       String?
  inventoryLogs InventoryLog[]

  @@index([brandId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive, status])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  BACKORDER
}

enum Currency {
  GHS
  USD
  EUR
  GBP
  NGN
}

enum DeliveryOptions {
  LOCAL_DELIVERY
  INTERNATIONAL_DELIVERY
  SELECTED_REGIONS
}

model Review {
  id        String    @id @default(cuid())
  score     Int
  comment   String?
  productId String
  userId    String
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
}

model Discount {
  id              String       @id @default(cuid())
  name            String
  description     String?
  type            DiscountType
  value           Decimal      @db.Decimal(14, 2)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean      @default(false)
  products        Product[]
  variants        Variant[]
  categories      Category[]
  minimumPurchase Decimal?     @db.Decimal(14, 2)
  orderItems      OrderItem[]
  cartItems       CartItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([startDate, endDate, isActive])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id              String    @id @default(cuid())
  cartId          String
  productId       String
  variantId       String?
  quantity        Int       @default(1)
  cart            Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         Variant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  originalPrice   Decimal?  @db.Decimal(14, 2)
  discountedPrice Decimal?  @db.Decimal(14, 2)
  discount        Discount? @relation(fields: [discountId], references: [id])
  discountId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cartId, productId])
  @@index([variantId])
  @@index([discountId])
}

model Order {
  id                      String           @id @default(cuid())
  orderNumber             Int              @unique
  userId                  String
  user                    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  discountTotal           Decimal?         @db.Decimal(14, 2)
  totalWithOutDiscount    Decimal?         @db.Decimal(14, 2)
  subtotal                Decimal?         @db.Decimal(14, 2)
  shippingFee             Decimal?         @db.Decimal(14, 2)
  totalAmount             Decimal          @db.Decimal(14, 2)
  status                  OrderStatus      @default(PENDING)
  fulfillmentType         FulfillmentType  @default(DELIVERY)
  shippingAddressId       String?
  shippingAddress         Address?         @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  pickupLocationId        String?
  pickupLocation          PickupLocation?  @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  shippingAddressSnapshot Json?
  pickupLocationSnapshot  Json?
  trackingNumber          String?
  carrier                 String?
  couponId                String?
  coupon                  Coupon?          @relation(fields: [couponId], references: [id])
  couponDiscount          Decimal?         @db.Decimal(14, 2)
  paymentMethod           PaymentMethod    @default(ONLINE)
  contactEmail            String
  contactPhone            String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deleted                 Boolean          @default(false)
  deletedAt               DateTime?
  items                   OrderItem[]
  paymentIntent           PaymentIntent?
  cashCollections         CashCollection[]
  returnRequests          ReturnRequest[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  quantity       Int       @default(1)
  priceAtOrder   Decimal   @db.Decimal(14, 2)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        Variant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())
  originalPrice  Decimal   @db.Decimal(14, 2)
  discountAmount Decimal?  @db.Decimal(14, 2)
  discount       Discount? @relation(fields: [discountId], references: [id])
  discountId     String?

  @@index([orderId])
  @@index([productId, orderId])
  @@index([variantId])
  @@index([discountId])
}

model PaymentIntent {
  id        String              @id @default(cuid())
  orderId   String              @unique
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount    Decimal             @db.Decimal(14, 2)
  currency  String              @default("GHS")
  status    PaymentIntentStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  attempts  PaymentAttempt[]
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  intentId         String
  intent           PaymentIntent        @relation(fields: [intentId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  reference        String?              @unique
  amount           Decimal              @db.Decimal(14, 2)
  currency         String               @default("GHS")
  status           PaymentStatus        @default(PENDING)
  rawStatus        String?
  reviewReason     PaymentReviewReason?
  channel          String
  providerDetails  Json?
  idempotencyKey   String?
  authorizationUrl String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deleted          Boolean              @default(false)
  deletedAt        DateTime?
  refunds          Refund[]
  cashCollection   CashCollection?

  @@unique([intentId, idempotencyKey])
  @@index([intentId])
  @@index([status, createdAt])
}

model Refund {
  id              String         @id @default(cuid())
  attemptId       String
  attempt         PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  amount          Decimal        @db.Decimal(14, 2)
  currency        String         @default("GHS")
  status          RefundStatus   @default(PENDING)
  providerRef     String?        @unique
  failureReason   String?
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([attemptId])
  @@index([status])
}

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventKey    String
  event       String
  reference   String?
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  attempts    Int             @default(0)
  lastError   String?

  @@unique([provider, eventKey])
  @@index([processedAt, receivedAt])
}

model CashCollection {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptId    String?         @unique
  attempt      PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  riderId      String?
  recordedById String?
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("GHS")
  collectedAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([orderId])
}

model WishList {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  ABANDONED
}

enum PaymentIntentStatus {
  PENDING
  PAID
}

enum PaymentReviewReason {
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  ORDER_NOT_PAYABLE
  ALREADY_PAID
}

enum PaymentProvider {
  PAYSTACK
  CASH_ON_DELIVERY
}

enum RefundStatus {
  PENDING
  SENDING
  PROCESSED
  FAILED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

enum InventoryAction {
  RESTOCK
  ORDER_DEDUCTION
  RETURN_RESTORE
  ADJUSTMENT
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique @db.VarChar(50)
  discountType       DiscountType
  value              Decimal       @db.Decimal(14, 2)
  usageLimit         Int?
  usedCount          Int           @default(0)
  expiresAt          DateTime?
  isActive           Boolean       @default(true)
  minimumOrderAmount Decimal?      @db.Decimal(14, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  usages             CouponUsage[]
  orders             Order[]

  @@index([isActive, expiresAt])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String
  reason       String       @db.Text
  status       ReturnStatus @default(PENDING)
  refundAmount Decimal?     @db.Decimal(14, 2)
  adminNote    String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  refund       Refund?
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model InventoryLog {
  id             String          @id @default(cuid())
  productId      String
  variantId      String?
  action         InventoryAction
  quantityChange Int
  quantityAfter  Int
  reason         String?
  actorId        String?
  createdAt      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        Variant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model PickupLocation {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  country   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([isActive])
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String   @unique
  cities    String[]
  fee       Decimal  @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Store {
  id               String   @id @default(cuid())
  singleton        Boolean  @unique @default(true)
  legalName        String
  tradingName      String
  tin              String?
  vatRegistered    Boolean  @default(false)
  pricesIncludeTax Boolean  @default(true)
  currency         Currency @default(GHS)
  supportEmail     String?
  supportPhone     String?
  nextOrderNumber  Int      @default(10001)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Tax {
  id        String   @id @default(cuid())
  name      String   @unique
  rate      Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
