// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["fullTextSearchPostgres", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                  @id @default(cuid())
  name                      String?
  email                     String                  @unique
  password                  String?
  phoneNumber               String?                 @unique
  role                      Role                    @default(USER)
  isActive                  Boolean                 @default(true)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  lastLoginAt               DateTime?
  profilePicture            String?
  failedLoginAttempts       Int                     @default(0)
  lockedUntil               DateTime?
  addresses                 Address[]
  reviews                   Review[]
  cart                      Cart?
  order                     Order[]
  authProvider              AuthProvider[]
  auditLog                  AuditLog[]
  wishlist                  WishList?
  refreshTokens             RefreshToken[]
  passwordResetToken        String?
  passwordResetTokenExp     DateTime?
  emailVerifiedAt           DateTime?
  pendingEmail              String?
  emailVerificationToken    String?                 @unique
  emailVerificationTokenExp DateTime?
  redemptions               Redemption[]
  customerGroups            CustomerGroupMember[]
  returnRequests            ReturnRequest[]
  storeMemberships          StoreMembership[]
  cashCollected             CashCollection[]        @relation("CashCollectionRider")
  shipmentsRidden           Shipment[]              @relation("ShipmentRider")
  deliveriesConfirmed       ProofOfDelivery[]       @relation("ProofOfDeliveryActor")
  cashRemitted              CashRemittance[]        @relation("CashRemittanceRider")
  cashRemittancesReceived   CashRemittance[]        @relation("CashRemittanceReceiver")
  paymentProviderConfigs    PaymentProviderConfig[]
  /// TOTP secret (base32), AES-256-GCM encrypted with MFA_ENCRYPTION_KEY; set at enrolment start
  mfaSecret                 String?
  /// Set once the first code confirmed enrolment; MFA is active only from then
  mfaEnabledAt              DateTime?
  /// Last accepted TOTP time step; codes for this step or earlier are replays
  mfaLastUsedStep           Int?
  mfaRecoveryCodes          MfaRecoveryCode[]
  /// Set when an SMS code sent to phoneVerifiedNumber was confirmed (P3-B.1); a trigger clears both when phoneNumber
  /// changes. The phone counts as verified only while phoneVerifiedNumber equals phoneNumber.
  phoneVerifiedAt           DateTime?
  phoneVerifiedNumber       String?
  codBlacklistEntries       CodBlacklistEntry[]
}

/// Single-use MFA recovery code, stored as a keyed hash (src/iam/mfa/mfa-crypto.ts).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthProvider {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model Address {
  id            String       @id @default(cuid())
  // Nullable only for addresses saved before they existed; the API requires them and checkout refuses without them.
  recipientName String?
  phone         String?
  region        GhanaRegion?
  street        String
  city          String
  area          String?
  landmark      String?
  ghanaPostGps  String?
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  zipCode       String?
  country       String
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Order         Order[]

  @@index([userId])
}

enum GhanaRegion {
  AHAFO
  ASHANTI
  BONO
  BONO_EAST
  CENTRAL
  EASTERN
  GREATER_ACCRA
  NORTH_EAST
  NORTHERN
  OTI
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  VOLTA
  WESTERN
  WESTERN_NORTH
}

model Category {
  id               String        @id @default(cuid())
  name             String        @unique
  description      String?       @db.Text
  image            String?
  products         Product[]
  subcategories    SubCategory[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  promotions       Promotion[]   @relation("CategoryToPromotion")
  rewardPromotions Promotion[]   @relation("PromotionRewardCategories")

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

model SubCategory {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  image       String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, categoryId])
}

model Brand {
  id               String      @id @default(cuid())
  name             String      @unique @db.VarChar(255)
  description      String?     @db.Text
  logo             String?
  products         Product[]
  promotions       Promotion[] @relation("BrandToPromotion")
  rewardPromotions Promotion[] @relation("PromotionRewardBrands")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Brand_name_trgm_idx")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// The SKU: the unit that is priced, stocked and sold (ADR-0003). Every product has at least one.
model Variant {
  id                String              @id @default(cuid())
  sku               String              @unique
  barcode           String?             @unique
  /// Values for the product type's variant axes (ADR-0002), checked by product-types/domain/attribute-validation.ts
  optionValues      Json                @default("{}")
  /// Canonical form of optionValues (attribute-validation.ts), unique per product among active variants
  optionsKey        String              @default("")
  /// Null only for a legacy product migrated without a price (its variant is archived until priced)
  price             Decimal?            @db.Decimal(14, 2)
  /// Admin-entered price before tax; price is basePrice with tax added when the product is taxable
  basePrice         Decimal?            @db.Decimal(14, 2)
  isActive          Boolean             @default(true)
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  image             String?
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItem          CartItem[]
  orderItem         OrderItem[]
  promotions        Promotion[]         @relation("PromotionToVariant")
  rewardPromotions  Promotion[]         @relation("PromotionRewardVariants")
  lowStockThreshold Int?                @default(5)
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  priceChanges      PriceChange[]
  priceListEntries  PriceListEntry[]
  transferLines     StockTransferLine[]
  stockTakeLines    StockTakeLine[]
  lowStockAlerts    LowStockAlert[]
  lots              Lot[]
  serialUnits       SerialUnit[]
  /// Weighted-average unit cost (P4-E.1), store-wide, tax-exclusive, 4 dp; null = unknown. Changes only through
  /// VariantCostService (a purchase-order receipt or a manual set), each change recorded as a CostChange.
  costPrice         Decimal?            @db.Decimal(14, 4)
  costChanges       CostChange[]
  purchaseLines     PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, optionsKey], where: raw("\"isActive\""))
  @@index([productId])
}

/// A kind of product (ADR-0002) owning the attribute definitions its products and variants are validated against.
/// System types are seeded by migration and immutable.
model ProductType {
  id          String                @id @default(cuid())
  key         String                @unique @db.VarChar(50)
  name        String                @db.VarChar(100)
  description String?               @db.VarChar(500)
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  attributes  AttributeDefinition[]
  products    Product[]
}

model AttributeDefinition {
  id            String            @id @default(cuid())
  productTypeId String
  key           String            @db.VarChar(50)
  label         String            @db.VarChar(100)
  dataType      AttributeDataType
  /// Unit of a NUMBER attribute's values, e.g. "g" or "ml"
  unit          String?           @db.VarChar(20)
  isRequired    Boolean           @default(false)
  /// Empty means any value of the data type
  allowedValues String[]
  /// Variant axes are set per variant (optionValues); the others per product (attributes)
  isVariantAxis Boolean           @default(false)
  isFilterable  Boolean           @default(false)
  position      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  productType   ProductType       @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([productTypeId, key])
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
}

/// How a serial number is checked (P4-D.1): IMEI is 15 digits with a valid Luhn check digit; FREE_TEXT is 1-64
/// letters, digits and - _ . /, stored upper case.
enum SerialFormat {
  FREE_TEXT
  IMEI
}

enum FulfilmentKind {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum UnitOfMeasure {
  EACH
  KG
  G
  L
  ML
  M
}

model Product {
  id String @id @default(cuid())

  name             String  @db.VarChar(255)
  description      String? @db.Text
  shortDescription String? @db.VarChar(500)

  // Price, stock, SKU and barcode live on the variants (ADR-0003).
  currency  Currency? @default(GHS)
  /// Variant prices add tax to their basePrice when true
  isTaxable Boolean   @default(false)

  images      String[]
  attachments String[]

  isActive    Boolean        @default(true)
  status      ProductStatus? @default(DRAFT)
  publishedAt DateTime?

  deliveryOptions         DeliveryOptions[] @default([LOCAL_DELIVERY])
  selectedDeliveryRegions String[]

  expiryDate DateTime?

  /// Defaults to the seeded General type
  productTypeId String      @default("product_type_general")
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  /// Values for the product type's non-axis attributes (ADR-0002), checked by attribute-validation.ts
  attributes    Json        @default("{}")

  // Capability columns (ADR-0002 option 4): typed because checkout, inventory, delivery or compliance will branch on them.
  requiresPrescription Boolean        @default(false)
  isPerishable         Boolean        @default(false)
  shelfLifeDays        Int?
  trackLots            Boolean        @default(false)
  trackSerials         Boolean        @default(false)
  /// How serials of a trackSerials product are validated and normalised (P4-D.1)
  serialFormat         SerialFormat   @default(FREE_TEXT)
  /// Warranty from delivery, in months, of each serialised unit sold (P4-D.1); null: no warranty
  warrantyMonths       Int?
  fulfilmentKind       FulfilmentKind @default(PHYSICAL)
  unitOfMeasure        UnitOfMeasure  @default(EACH)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  categoryId       String?
  category         Category?    @relation(fields: [categoryId], references: [id])
  subcategoryId    String?
  subcategory      SubCategory? @relation(fields: [subcategoryId], references: [id])
  tags             Tag[]
  reviews          Review[]
  variants         Variant[]
  promotions       Promotion[]  @relation("ProductToPromotion")
  rewardPromotions Promotion[]  @relation("PromotionRewardProducts")
  cartItem         CartItem[]
  orderItem        OrderItem[]
  wishlist         WishList[]
  brand            Brand?       @relation(fields: [brandId], references: [id])
  brandId          String?
  /// Full-text document (P6-S.1, simple config): name weight A; brand, category, sub-category and tag names B;
  /// short description and description C. Kept up to date by database triggers, never written by the app.
  searchVector     Unsupported("tsvector")?

  @@index([brandId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive, status])
  @@index([productTypeId])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Currency {
  GHS
  USD
  EUR
  GBP
  NGN
}

enum DeliveryOptions {
  LOCAL_DELIVERY
  INTERNATIONAL_DELIVERY
  SELECTED_REGIONS
}

model Review {
  id        String    @id @default(cuid())
  score     Int
  comment   String?
  productId String
  userId    String
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  /// The variant's product, kept for lookups by product (a variant never changes product)
  productId     String
  variantId     String
  quantity      Int      @default(1)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  originalPrice Decimal? @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                      String             @id @default(cuid())
  orderNumber             Int                @unique
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency                Currency
  /// 1 for orders priced and snapshotted by createOrder since P1-O.1; 0 for older orders, whose totals are copied
  /// from what they stored (null where unknown) and which have no tax lines
  pricingVersion          Int
  /// Sum of unit list price x quantity, before any discount (prices include tax)
  subtotal                Decimal?           @db.Decimal(14, 2)
  /// Every discount: product discounts and the coupon (the negated sum of the adjustments)
  discountTotal           Decimal?           @db.Decimal(14, 2)
  /// Tax included in the line totals (the sum of the line taxes)
  taxTotal                Decimal?           @db.Decimal(14, 2)
  shippingTotal           Decimal?           @db.Decimal(14, 2)
  /// The amount charged: subtotal - discountTotal + shippingTotal
  grandTotal              Decimal            @db.Decimal(14, 2)
  status                  OrderStatus        @default(PLACED)
  fulfillmentType         FulfillmentType    @default(DELIVERY)
  shippingAddressId       String?
  shippingAddress         Address?           @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  pickupLocationId        String?
  pickupLocation          PickupLocation?    @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  shippingAddressSnapshot Json?
  pickupLocationSnapshot  Json?
  /// The coupon code entered at checkout
  couponCodeId            String?
  couponCode              CouponCode?        @relation(fields: [couponCodeId], references: [id])
  paymentMethod           PaymentMethod      @default(ONLINE)
  contactEmail            String
  contactPhone            String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deleted                 Boolean            @default(false)
  deletedAt               DateTime?
  items                   OrderItem[]
  adjustments             OrderAdjustment[]
  redemptions             Redemption[]
  paymentIntent           PaymentIntent?
  cashCollections         CashCollection[]
  returnRequests          ReturnRequest[]
  stockReservations       StockReservation[]
  shipments               Shipment[]
  statusEvents            OrderStatusEvent[]
  reviewFlags             OrderReviewFlag[]
  disputes                Dispute[]
  /// Cash on delivery only: the account's verified phone (E.164) the order was placed under (P3-B.2 open-order cap)
  codPhone                String?
  /// Where the order's stock is reserved and fulfilled from, chosen at placement (P4-A.1); null for orders without
  /// reservations
  stockLocationId         String?
  stockLocation           StockLocation?     @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  /// Delivery snapshot (P5-A.1), null for pickup and older orders. Ids without foreign keys: the zone or rule may
  /// change or be deleted later
  shippingZoneId          String?
  shippingZoneName        String?
  rateRuleId              String?
  serviceLevel            DeliveryServiceLevel?
  /// The delivery fee before free-shipping promotions (shippingTotal is after them)
  shippingFee             Decimal?           @db.Decimal(14, 2)
  /// The delivery slot booked (P5-A.2): a snapshot of the slot id, date and window; set when it was released
  deliverySlotId          String?
  deliveryDate            DateTime?          @db.Date
  deliveryWindowStart     Int?
  deliveryWindowEnd       Int?
  deliverySlotReleasedAt  DateTime?

  @@index([userId, status])
  @@index([codPhone])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deliveryDate])
}

model OrderItem {
  id                   String             @id @default(cuid())
  orderId              String
  productId            String
  variantId            String
  /// Product name when ordered (orders placed before P1-O.1 copy the name the product had when migrated)
  productName          String
  /// Snapshot of the variant's SKU and option values when ordered (null on lines ordered before P1-V.3)
  sku                  String?
  optionValues         Json?
  quantity             Int                @default(1)
  /// Catalogue price of one unit when ordered, tax included
  unitListPrice        Decimal            @db.Decimal(14, 2)
  /// Product discount taken off one unit
  unitDiscount         Decimal            @db.Decimal(14, 2)
  /// One unit after its discount, without tax; null on orders placed before P1-O.1 (tax unknown)
  unitNet              Decimal?           @db.Decimal(14, 2)
  /// Tax included in one discounted unit; null on orders placed before P1-O.1
  unitTax              Decimal?           @db.Decimal(14, 2)
  /// (unitListPrice - unitDiscount) x quantity, which is (unitNet + unitTax) x quantity
  lineTotal            Decimal            @db.Decimal(14, 2)
  /// The line's share of the order-level (cart) adjustments, <= 0: lineTotal + this is what the line was charged
  orderAdjustmentShare Decimal            @default(0) @db.Decimal(14, 2)
  /// The price list unitListPrice came from (P2-W.1); null for the variant's normal price. A snapshot, not a foreign
  /// key: the list may change or be deleted later
  priceListId          String?
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant              Variant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())
  reservations         StockReservation[]
  adjustments          OrderAdjustment[]
  taxLines             OrderLineTax[]
  refundLines          RefundLine[]
  serialUnits          SerialUnit[]
  shipmentItems        ShipmentItem[]

  @@index([orderId])
  @@index([productId, orderId])
  @@index([variantId])
}

/// A promotion taken off an order (ADR-0005 adjustments), signed: reductions are negative. Line-level when orderItemId
/// is set (already reflected in that line's unitDiscount), order-level otherwise. DISCOUNT for an automatic promotion,
/// COUPON for one a coupon code unlocked.
model OrderAdjustment {
  id          String                @id @default(cuid())
  orderId     String
  orderItemId String?
  type        OrderAdjustmentType
  /// What it reduces: the merchandise (a line or the cart) or the delivery fee (a free-shipping promotion, P2-B.6)
  target      OrderAdjustmentTarget @default(MERCHANDISE)
  /// The Promotion id it came from (kept when the promotion is later deleted)
  sourceId    String?
  /// The coupon code that unlocked it, when ordered
  code        String?
  amount      Decimal               @db.Decimal(14, 2)
  createdAt   DateTime              @default(now())
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
}

enum OrderAdjustmentType {
  DISCOUNT
  COUPON
}

enum OrderAdjustmentTarget {
  /// A line (orderItemId set) or the cart: counted in discountTotal
  MERCHANDISE
  /// The delivery fee: already taken off shippingTotal
  SHIPPING
}

/// One tax included in an order line, as the pricing at placement computed it (ADR-0006 snapshot; never recomputed).
model OrderLineTax {
  id          String    @id @default(cuid())
  orderItemId String
  /// The Tax row it came from (kept when the tax is later changed or deleted)
  taxId       String?
  name        String
  rate        Decimal   @db.Decimal(9, 6)
  /// The line's amount without tax that the rate applies to
  base        Decimal   @db.Decimal(14, 2)
  amount      Decimal   @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model PaymentIntent {
  id        String              @id @default(cuid())
  orderId   String              @unique
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount    Decimal             @db.Decimal(14, 2)
  currency  String              @default("GHS")
  status    PaymentIntentStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  attempts  PaymentAttempt[]
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  intentId         String
  intent           PaymentIntent        @relation(fields: [intentId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  reference        String?              @unique
  amount           Decimal              @db.Decimal(14, 2)
  currency         String               @default("GHS")
  status           PaymentStatus        @default(PENDING)
  rawStatus        String?
  reviewReason     PaymentReviewReason?
  channel          String
  providerDetails  Json?
  idempotencyKey   String?
  authorizationUrl String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deleted          Boolean              @default(false)
  deletedAt        DateTime?
  refunds          Refund[]
  cashCollection   CashCollection?
  disputes         Dispute[]

  @@unique([intentId, idempotencyKey])
  @@index([intentId])
  @@index([status, createdAt])
}

model Refund {
  id              String         @id @default(cuid())
  attemptId       String
  attempt         PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  amount          Decimal        @db.Decimal(14, 2)
  /// Tax included in the amount, read from the order's stored tax lines in proportion; null when the order has no
  /// tax snapshot (placed before P1-O.1) or the refund returns a charge that never paid the order
  taxAmount       Decimal?       @db.Decimal(14, 2)
  currency        String         @default("GHS")
  status          RefundStatus   @default(PENDING)
  providerRef     String?        @unique
  failureReason   String?
  idempotencyKey  String         @unique
  reason          RefundReason
  /// Staff's internal note (required for OTHER); never shown to the customer
  note            String?        @db.Text
  /// How the money goes back: through the payment's provider, or handed back in cash by staff (cash on delivery)
  method          RefundMethod   @default(PROVIDER)
  /// The part of the amount that returns the order's delivery fee (refunded at most once)
  shippingAmount  Decimal        @default(0) @db.Decimal(14, 2)
  /// The staff member who issued it through refundOrder; null for return refunds and auto-refunds (see the audit log)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lines           RefundLine[]

  @@index([attemptId])
  @@index([status])
}

/// Units of an order line a refund pays back. Amounts come from the line's stored snapshot, never re-priced.
model RefundLine {
  id          String    @id @default(cuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Restrict)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  /// What these units were charged: their share of the line total and of the order-level adjustments
  amount      Decimal   @db.Decimal(14, 2)

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
}

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventKey    String
  event       String
  reference   String?
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  attempts    Int             @default(0)
  lastError   String?

  @@unique([provider, eventKey])
  @@index([processedAt, receivedAt])
}

model CashCollection {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptId    String?         @unique
  attempt      PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  /// The staff member who took the cash (P3-B.3); null on collections recorded before riders were tracked
  riderId      String?
  rider        User?           @relation("CashCollectionRider", fields: [riderId], references: [id], onDelete: Restrict)
  recordedById String?
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("GHS")
  collectedAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())
  /// Set once, when the rider hands the cash to the store; a trigger refuses any other update
  remittanceId String?
  remittance   CashRemittance? @relation(fields: [remittanceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([riderId, collectedAt])
  @@index([remittanceId])
}

/// Cash a rider handed to the store (P3-B.3), covering a set of that rider's collections. Immutable: a correction is
/// a new remittance. `discrepancy` = amount - expectedAmount (negative: short, positive: over); a note is required
/// when it is not zero.
model CashRemittance {
  id             String           @id @default(cuid())
  riderId        String
  rider          User             @relation("CashRemittanceRider", fields: [riderId], references: [id], onDelete: Restrict)
  receivedById   String
  receivedBy     User             @relation("CashRemittanceReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  amount         Decimal          @db.Decimal(14, 2)
  /// The sum of the collections it covers
  expectedAmount Decimal          @db.Decimal(14, 2)
  discrepancy    Decimal          @db.Decimal(14, 2)
  currency       String
  note           String?
  receivedAt     DateTime
  createdAt      DateTime         @default(now())
  collections    CashCollection[]

  @@index([riderId, receivedAt])
  @@index([receivedAt])
}

model WishList {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Transactional outbox (ADR-0009): written in the same transaction as the state change, published to BullMQ by the
/// worker's relay. `type` is a versioned event name such as `order.placed.v1`.
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  /// The request that recorded the event; the relay passes it to the job so worker logs correlate.
  requestId   String?

  @@index([publishedAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

/// A payment attempt: CANCELLED when superseded by a newer attempt or its order closed (a late provider verdict can
/// still settle it), FAILED when the provider refused it.
enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  CANCELLED
}

/// The order's payment machine (src/payment/payment-intent-status.ts).
enum PaymentIntentStatus {
  PENDING
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentReviewReason {
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  ORDER_NOT_PAYABLE
  ALREADY_PAID
}

enum PaymentProvider {
  PAYSTACK
  CASH_ON_DELIVERY
}

enum RefundStatus {
  PENDING
  SENDING
  PROCESSED
  FAILED
}

enum RefundReason {
  CUSTOMER_REQUEST
  DAMAGED
  WRONG_ITEM
  NOT_DELIVERED
  PRICE_ADJUSTMENT
  DUPLICATE_CHARGE
  OTHER
  /// Set by the returns flow
  RETURN
  /// Set by the system for a charge it could not accept (late, wrong amount or duplicate payment)
  PAYMENT_NOT_ACCEPTED
}

enum RefundMethod {
  PROVIDER
  CASH
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
}

/// The order machine (src/order/order-status.ts).
enum OrderStatus {
  PLACED
  CONFIRMED
  IN_FULFILMENT
  COMPLETED
  CANCELLED
  EXPIRED
  PAYMENT_REVIEW
}

/// The fulfilment machine of a shipment (src/order/shipment-status.ts).
enum ShipmentStatus {
  PENDING
  PICKING
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

/// Some or all of an order's goods on their way to the customer (P5-B.1): an order may be split into several, each
/// with its items (order line, quantity). Staff create them from the order's unshipped quantities; a cancelled shipment
/// (only before dispatch) gives its items back. A trigger keeps every line's quantity over its non-cancelled shipments
/// within the ordered quantity.
model Shipment {
  id             String                @id @default(cuid())
  orderId        String
  status         ShipmentStatus        @default(PENDING)
  carrier        String?
  trackingNumber String?
  /// When it went out for delivery or became ready for pickup (null on shipments migrated without that date)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  /// The rider delivering it (P5-C.1): an active staff member whose role holds delivery.ride; delivery orders only
  riderId        String?
  rider          User?                 @relation("ShipmentRider", fields: [riderId], references: [id], onDelete: Restrict)
  /// When the current rider was assigned
  assignedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events         ShipmentStatusEvent[]
  items          ShipmentItem[]
  proof          ProofOfDelivery?

  @@index([orderId])
  @@index([riderId, status])
}

enum ProofOfDeliveryMethod {
  CODE
  OVERRIDE
}

/// How a rider's delivery was confirmed (P5-C.2): the customer's code, or a staff override with a reason; an optional
/// photo (Cloudinary), recipient name and position. One per shipment, append-only (a trigger refuses updates and direct
/// deletes; deleting the shipment removes it).
model ProofOfDelivery {
  id             String                @id @default(cuid())
  shipmentId     String                @unique
  shipment       Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  method         ProofOfDeliveryMethod
  /// Required for OVERRIDE (CHECK), null for CODE
  overrideReason String?
  /// The rider or staff member who confirmed it (for an override, the staff member who overrode)
  deliveredById  String
  deliveredBy    User                  @relation("ProofOfDeliveryActor", fields: [deliveredById], references: [id], onDelete: Restrict)
  deliveredAt    DateTime
  photoUrl       String?
  photoPublicId  String?
  recipientName  String?
  latitude       Decimal?              @db.Decimal(9, 6)
  longitude      Decimal?              @db.Decimal(9, 6)
  createdAt      DateTime              @default(now())

  @@index([deliveredById])
}

/// Units of one order line in a shipment (P5-B.1). Written with the shipment and never changed.
model ShipmentItem {
  id          String       @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  createdAt   DateTime     @default(now())
  shipment    Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  serialUnits SerialUnit[]

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

/// The order's status history, written in the same transaction as every transition; the customer's tracking timeline.
model OrderStatusEvent {
  id        String       @id @default(cuid())
  orderId   String
  /// Null for the first event (the order was placed, or migrated)
  from      OrderStatus?
  to        OrderStatus
  /// The staff member or customer who caused it; null for the system (payment, expiry)
  actorId   String?
  reason    String?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ShipmentStatusEvent {
  id         String          @id @default(cuid())
  shipmentId String
  from       ShipmentStatus?
  to         ShipmentStatus
  actorId    String?
  reason     String?
  createdAt  DateTime        @default(now())
  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String
  reason       String       @db.Text
  status       ReturnStatus @default(PENDING)
  refundAmount Decimal?     @db.Decimal(14, 2)
  adminNote    String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  refund       Refund?
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model PickupLocation {
  id                  String                        @id @default(cuid())
  name                String
  address             String
  city                String
  /// Null only for points migrated from a free-text state that matched no region (P5-E.1)
  region              GhanaRegion?
  country             String
  /// E.164; customers call it about their collection
  contactPhone        String?
  /// How to find the counter and what to bring
  instructions        String?
  ghanaPostGps        String?
  latitude            Decimal?                      @db.Decimal(9, 6)
  longitude           Decimal?                      @db.Decimal(9, 6)
  isActive            Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  orders              Order[]
  /// Stock locations that fulfil orders collected here, by priority; none = the default location
  fulfilmentLocations PickupLocationStockLocation[]
  /// Opening hours per weekday (P5-E.1); a weekday without a row is closed
  openingHours        PickupOpeningHours[]

  @@index([isActive])
}

/// When a pickup point is open on a weekday, minutes from midnight in Africa/Accra (= UTC).
model PickupOpeningHours {
  pickupLocationId String
  pickupLocation   PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade)
  weekday          Weekday
  opensMinute      Int
  closesMinute     Int

  @@id([pickupLocationId, weekday])
}

model ShippingZone {
  id                  String                      @id @default(cuid())
  name                String                      @unique
  isActive            Boolean                     @default(true)
  /// Cash on delivery may be chosen for deliveries to this zone (P3-B.2)
  codEnabled          Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  /// Free-shipping promotions limited to this zone
  promotions          Promotion[]
  /// Stock locations that fulfil deliveries here, by priority; none = the default location
  fulfilmentLocations ShippingZoneStockLocation[]
  /// The regions, towns and areas the zone delivers to (P5-A.1)
  areas               ZoneArea[]
  /// The delivery fee per service level (P5-A.1)
  rateRules           RateRule[]
  /// Weekly delivery windows for STANDARD delivery (P5-A.2); none = no slot is chosen
  deliverySlots       DeliverySlot[]
  /// Dates the zone does not deliver on (P5-A.2)
  deliveryClosures    DeliveryClosure[]

  @@index([isActive])
}

/// How specific a zone area is: an address matches its most specific entry (AREA > TOWN > REGION).
enum ZoneAreaLevel {
  REGION
  TOWN
  AREA
}

/// A region, a town, or an area within a town that a delivery zone covers (P5-A.1). Towns and areas are stored
/// normalised (shipping-zones/zone-matching.ts); matchKey is unique, so a place belongs to one zone at each level.
model ZoneArea {
  id       String        @id @default(cuid())
  zoneId   String
  zone     ShippingZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  level    ZoneAreaLevel
  region   GhanaRegion?
  town     String?
  area     String?
  /// "<level>:<value>": REGION:GREATER_ACCRA, TOWN:accra, AREA:accra|osu
  matchKey String        @unique

  @@index([zoneId])
}

enum DeliveryServiceLevel {
  STANDARD
  EXPRESS
}

/// The delivery fee of a zone for one service level (P5-A.1): the base fee, raised by the weight band the cart
/// reaches, waived when the merchandise total after promotions reaches freeAbove (pure rule in delivery-fee.ts).
model RateRule {
  id           String               @id @default(cuid())
  zoneId       String
  zone         ShippingZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  serviceLevel DeliveryServiceLevel
  baseFee      Decimal              @db.Decimal(14, 2)
  freeAbove    Decimal?             @db.Decimal(14, 2)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  weightBands  RateWeightBand[]

  @@unique([zoneId, serviceLevel], map: "RateRule_one_active_per_zone_level", where: raw("\"isActive\""))
  @@index([zoneId])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// A weekly delivery window of a zone (P5-A.2), in Africa/Accra time (= UTC, no daylight saving): minutes from
/// midnight. Bookable until cutoffHours before it starts, up to capacity orders per date (pure rules in
/// shipping-zones/slots/delivery-slots.ts).
model DeliverySlot {
  id          String                @id @default(cuid())
  zoneId      String
  zone        ShippingZone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  weekday     Weekday
  startMinute Int
  endMinute   Int
  capacity    Int
  cutoffHours Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  bookings    DeliverySlotBooking[]

  @@index([zoneId])
}

/// The orders booked into a slot on one date: placement increments booked conditionally (booked < capacity), cancel
/// and expiry decrement it once.
model DeliverySlotBooking {
  id     String       @id @default(cuid())
  slotId String
  slot   DeliverySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  date   DateTime     @db.Date
  booked Int          @default(0)

  @@unique([slotId, date])
}

/// A date a zone does not deliver on (holiday, closure).
model DeliveryClosure {
  id     String       @id @default(cuid())
  zoneId String
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  date   DateTime     @db.Date
  reason String?

  @@unique([zoneId, date])
}

/// From fromGrams of cart weight up, the rule charges fee instead of its base fee.
model RateWeightBand {
  id         String   @id @default(cuid())
  rateRuleId String
  rateRule   RateRule @relation(fields: [rateRuleId], references: [id], onDelete: Cascade)
  fromGrams  Int
  fee        Decimal  @db.Decimal(14, 2)

  @@unique([rateRuleId, fromGrams])
}

model Store {
  id                         String                  @id @default(cuid())
  singleton                  Boolean                 @unique @default(true)
  legalName                  String
  tradingName                String
  tin                        String?
  vatRegistered              Boolean                 @default(false)
  pricesIncludeTax           Boolean                 @default(true)
  currency                   Currency                @default(GHS)
  supportEmail               String?
  supportPhone               String?
  nextOrderNumber            Int                     @default(10001)
  /// Payment methods on offer (P3-A.2): online card and mobile money, each served by its provider, and pay on delivery.
  cardPaymentsEnabled        Boolean                 @default(true)
  mobileMoneyPaymentsEnabled Boolean                 @default(true)
  cashOnDeliveryEnabled      Boolean                 @default(true)
  /// An online provider; a CHECK constraint refuses CASH_ON_DELIVERY.
  cardPaymentProvider        PaymentProvider         @default(PAYSTACK)
  /// An online provider; a CHECK constraint refuses CASH_ON_DELIVERY.
  mobileMoneyPaymentProvider PaymentProvider         @default(PAYSTACK)
  /// Cash-on-delivery risk gates (P3-B.2): open COD orders allowed per verified phone, and the highest COD grand total.
  codMaxOpenOrdersPerPhone   Int                     @default(2)
  codMaxOrderTotal           Decimal                 @default(2000) @db.Decimal(14, 2)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  memberships                StoreMembership[]
  stockLocations             StockLocation[]
  paymentProviderConfigs     PaymentProviderConfig[]
  velocityLimits             VelocityLimit[]
  suppliers                  Supplier[]
}

/// Test or live keys, from the secret key's prefix (sk_test_ / sk_live_).
enum PaymentProviderMode {
  TEST
  LIVE
}

/// A payment provider's credentials for the store (P3-A.2). The secret key is AES-256-GCM encrypted with
/// PAYMENT_CONFIG_ENCRYPTION_KEY under a random IV, bound to "<storeId>:<provider>"; reads show only its last 4.
model PaymentProviderConfig {
  id                 String              @id @default(cuid())
  storeId            String
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider           PaymentProvider
  mode               PaymentProviderMode
  encryptedSecretKey String
  secretKeyLast4     String
  publicKey          String?
  callbackUrl        String?
  updatedById        String?
  updatedBy          User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([storeId, provider])
}

/// A velocity rule (P3-E.1): one event counted per subject over a fixed window. The catalogue (event, subject, window,
/// default limits) lives in src/fraud/velocity-rules.ts.
enum VelocityRule {
  ORDERS_PER_CUSTOMER_1H
  ORDERS_PER_CUSTOMER_24H
  ORDERS_PER_PHONE_24H
  ORDERS_PER_IP_1H
  ORDERS_PER_IP_24H
  PAYMENT_ATTEMPTS_PER_CUSTOMER_1H
  PAYMENT_ATTEMPTS_PER_IP_1H
  FAILED_PAYMENTS_PER_CUSTOMER_24H
  FAILED_PAYMENTS_PER_CARD_24H
}

/// SOFT lets the action through and flags the order for review; HARD refuses it (or, where nothing is left to refuse,
/// flags the order at HARD).
enum VelocityLevel {
  SOFT
  HARD
}

/// The store's limits for one velocity rule, replacing the code default (P3-E.1). A rule fires when its count in the
/// window goes above the limit. CHECKs: softLimit >= 1 and hardLimit >= softLimit.
model VelocityLimit {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rule        VelocityRule
  softLimit   Int
  hardLimit   Int
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([storeId, rule])
}

/// A velocity rule that fired on this order and needs staff review (P3-E.1). One open flag per order and rule. Holds
/// the count and the limit only, never the subject (phone, IP, card).
model OrderReviewFlag {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rule        VelocityRule
  level       VelocityLevel
  /// The count in the window when the rule fired
  count       Int
  /// The limit the count went above
  limit       Int
  createdAt   DateTime      @default(now())
  clearedAt   DateTime?
  clearedById String?
  clearNote   String?

  @@unique([orderId, rule], map: "OrderReviewFlag_one_open_per_rule", where: raw("\"clearedAt\" IS NULL"))
  @@index([clearedAt, createdAt])
  @@index([orderId])
}

/// Dispute lifecycle (P3-E.2); transitions in src/payment/disputes/dispute-status.ts. LOST and ACCEPTED (the merchant
/// accepted the claim) both returned the money to the customer.
enum DisputeStatus {
  OPEN
  AWAITING_EVIDENCE
  UNDER_REVIEW
  WON
  LOST
  ACCEPTED
}

enum DisputeSource {
  PROVIDER
  STAFF
}

/// A chargeback or dispute on a captured payment attempt (P3-E.2), from the provider's dispute webhooks or recorded
/// by staff. A provider's dispute id is unique per provider (staff may record one without an id).
model Dispute {
  id                String          @id @default(cuid())
  attemptId         String
  attempt           PaymentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  providerDisputeId String?
  amount            Decimal         @db.Decimal(14, 2)
  currency          String
  category          String?
  reason            String?
  status            DisputeStatus   @default(OPEN)
  source            DisputeSource
  evidenceDueAt     DateTime?
  openedAt          DateTime        @default(now())
  resolvedAt        DateTime?
  /// The staff user who recorded it by hand
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  notes             DisputeNote[]
  events            DisputeEvent[]

  @@unique([provider, providerDisputeId])
  @@index([attemptId, status])
  @@index([orderId])
  @@index([status, openedAt])
}

/// A staff evidence note on a dispute. Append-only (a trigger refuses updates and direct deletes).
model DisputeNote {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([disputeId, createdAt])
}

/// One status change of a dispute, the first one opening it (fromStatus null). Append-only like DisputeNote.
model DisputeEvent {
  id             String         @id @default(cuid())
  disputeId      String
  dispute        Dispute        @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fromStatus     DisputeStatus?
  toStatus       DisputeStatus
  source         DisputeSource
  /// The staff user, for STAFF changes
  actorId        String?
  /// The provider's own status and resolution, for PROVIDER changes
  providerStatus String?
  /// The stored webhook delivery that caused a PROVIDER change
  webhookEventId String?
  note           String?
  createdAt      DateTime       @default(now())

  @@index([disputeId, createdAt])
}

/// A staff role (ADR-0013). Permissions are code constants (src/iam/authorization/permissions.ts); system roles are
/// seeded by migration and immutable. Named StaffRole so it does not clash with the legacy Role enum.
model StaffRole {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  permissions String[]
  isSystem    Boolean           @default(false)
  mfaRequired Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships StoreMembership[]
}

/// A user's staff role in the store. Customers have none; one per user per store.
model StoreMembership {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  roleId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  role      StaffRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, storeId])
  @@index([roleId])
}

model Tax {
  id        String   @id @default(cuid())
  name      String   @unique
  rate      Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockLocationType {
  WAREHOUSE
  BRANCH
  PICKUP_POINT
}

/// Where stock is held (ADR-0008). Each store has exactly one default location (created by migration, always active);
/// an order is fulfilled from the first location of its shipping zone's or pickup point's list that can fill every
/// line, or from the default when that list is empty (P4-A.1). An inactive location is never chosen.
model StockLocation {
  id              String                        @id @default(cuid())
  storeId         String
  name            String
  type            StockLocationType             @default(WAREHOUSE)
  isActive        Boolean                       @default(true)
  isDefault       Boolean                       @default(false)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  store           Store                         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  levels          StockLevel[]
  reservations    StockReservation[]
  movements       StockMovement[]
  stockTakes      StockTake[]
  lowStockAlerts  LowStockAlert[]
  shippingZones   ShippingZoneStockLocation[]
  pickupLocations PickupLocationStockLocation[]
  orders          Order[]
  transfersOut    StockTransfer[]               @relation("StockTransferFrom")
  transfersIn     StockTransfer[]               @relation("StockTransferTo")
  lotStocks       LotStock[]
  serialUnits     SerialUnit[]
  purchaseOrders  PurchaseOrder[]

  @@unique([storeId], map: "StockLocation_one_default_per_store", where: raw("\"isDefault\""))
}

/// Stock of one variant (SKU) at one location. available = onHand - reserved. The database rejects a negative onHand
/// or reserved and reserved > onHand; every change writes a StockMovement in the same transaction.
model StockLevel {
  id         String        @id @default(cuid())
  variantId  String
  locationId String
  onHand     Int           @default(0)
  reserved   Int           @default(0)
  version    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  variant    Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([locationId])
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

/// Stock held for an order line. ACTIVE counts in StockLevel.reserved; CONSUMED has left onHand (payment or dispatch);
/// RELEASED has gone back (cancel or expiry). Each transition is a conditional update on the status.
model StockReservation {
  id          String                 @id @default(cuid())
  variantId   String
  locationId  String
  orderId     String
  orderItemId String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  /// When the unpaid order becomes eligible for expiry; null for cash-on-delivery orders and migrated ones
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  variant     Variant                @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location    StockLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, locationId])
  @@index([orderId])
  @@index([variantId, locationId, status])
}

/// A stock location that fulfils deliveries to a shipping zone, tried in ascending priority (P4-A.1).
model ShippingZoneStockLocation {
  shippingZoneId String
  locationId     String
  priority       Int
  shippingZone   ShippingZone  @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)
  location       StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([shippingZoneId, locationId])
  @@unique([shippingZoneId, priority])
  @@index([locationId])
}

/// A stock location that fulfils orders collected at a pickup point, tried in ascending priority (P4-A.1).
model PickupLocationStockLocation {
  pickupLocationId String
  locationId       String
  priority         Int
  pickupLocation   PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade)
  location         StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([pickupLocationId, locationId])
  @@unique([pickupLocationId, priority])
  @@index([locationId])
}

enum StockTransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

/// Stock moved between two locations (P4-A.2). Dispatch takes the lines off the source (TRANSFER movements); until
/// received they are in transit here, at neither location. Receipt adds what arrived to the destination and records
/// any shortfall on its line. Status changes are conditional updates (src/inventory/transfers/stock-transfer-rules.ts).
model StockTransfer {
  id             String              @id @default(cuid())
  fromLocationId String
  toLocationId   String
  status         StockTransferStatus @default(DRAFT)
  note           String?
  createdById    String
  dispatchedById String?
  dispatchedAt   DateTime?
  receivedById   String?
  receivedAt     DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  fromLocation   StockLocation       @relation("StockTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     StockLocation       @relation("StockTransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines          StockTransferLine[]

  @@index([status, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdAt])
}

/// One variant on a transfer. receivedQuantity is null until received; quantity - receivedQuantity is the variance.
model StockTransferLine {
  id               String        @id @default(cuid())
  transferId       String
  variantId        String
  quantity         Int
  receivedQuantity Int?
  varianceNote     String?
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant          Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([transferId, variantId])
  @@index([variantId])
}

enum StockMovementReason {
  OPENING_BALANCE
  RECEIPT
  SALE
  RETURN_RESTOCK
  ADJUSTMENT
  TRANSFER
  RESERVE
  RELEASE
}

/// Why staff adjusted stock (P4-B.1). STOCK_TAKE is set only by an approved stock-take, never by hand.
enum StockAdjustmentReason {
  DAMAGED
  LOST
  FOUND
  EXPIRED
  CORRECTION
  STOCK_TAKE
  OTHER
}

/// Append-only stock ledger (ADR-0008): one row per StockLevel change, in the same transaction. Per (variant,
/// location), the sum of onHandDelta is onHand and the sum of reservedDelta is reserved. A trigger refuses updates
/// and direct deletes.
model StockMovement {
  id               String                 @id @default(cuid())
  variantId        String
  locationId       String
  onHandDelta      Int
  reservedDelta    Int                    @default(0)
  reason           StockMovementReason
  /// What caused the movement, e.g. ("Order", orderId) or ("ReturnRequest", returnRequestId)
  refType          String?
  refId            String?
  actorId          String?
  note             String?
  createdAt        DateTime               @default(now())
  variant          Variant                @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location         StockLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// Why staff adjusted (P4-B.1): set on ADJUSTMENT movements only (a CHECK refuses it elsewhere); null before P4-B.1
  adjustmentReason StockAdjustmentReason?
  /// The lot the units came from or went to (P4-C.1): set on every on-hand change of a lot-tracked variant, one
  /// movement per lot; null for untracked variants and for RESERVE/RELEASE (a CHECK refuses it there)
  lotId            String?
  lot              Lot?                   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  /// What one unit cost (P4-E.1): set on RECEIPT movements of a purchase-order receipt only (a CHECK refuses it on
  /// other reasons); null for every other movement
  unitCost         Decimal?               @db.Decimal(14, 4)

  @@index([variantId, createdAt])
  @@index([lotId])
  @@index([locationId])
  @@index([refType, refId])
  @@index([createdAt])
}

/// A batch of one variant with its expiry (P4-C.1), for products with trackLots; the lot number is unique per variant.
/// Units of a lot past expiresAt are not sold; the hourly lot-expiry job writes them off (ADJUSTMENT, EXPIRED).
model Lot {
  id             String                     @id @default(cuid())
  variantId      String
  lotNumber      String                     @db.VarChar(100)
  expiresAt      DateTime
  manufacturedAt DateTime?
  createdAt      DateTime                   @default(now())
  variant        Variant                    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stock          LotStock[]
  movements      StockMovement[]
  receiptLines   PurchaseOrderReceiptLine[]

  @@unique([variantId, lotNumber])
  @@index([expiresAt])
}

/// Units of a lot at one location (P4-C.1). For a lot-tracked variant the lots at a location add up to that
/// StockLevel's onHand (checked by the stock reconciliation job). Changed only by StockLedgerService, with the lot's
/// StockMovement in the same transaction; the database rejects a negative onHand.
model LotStock {
  id         String        @id @default(cuid())
  lotId      String
  locationId String
  onHand     Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lot        Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([lotId, locationId])
  @@index([locationId])
}

/// OPEN (counting) -> SUBMITTED (counts closed) -> APPROVED (variances posted), or CANCELLED before approval (P4-B.1).
enum StockTakeStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

/// A stock count session at one location (P4-B.1): lines for a category's variants, a list of variants, or every
/// variant. Approval posts each non-zero variance as an ADJUSTMENT (STOCK_TAKE) referencing the session. At most one
/// OPEN or SUBMITTED stock-take per location.
model StockTake {
  id            String          @id @default(cuid())
  locationId    String
  status        StockTakeStatus @default(OPEN)
  /// The category whose variants were counted; null for a list of variants or a full count
  categoryId    String?
  note          String?
  openedById    String
  openedAt      DateTime        @default(now())
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  location      StockLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines         StockTakeLine[]

  @@unique([locationId], map: "StockTake_one_open_per_location", where: raw("status = ANY (ARRAY['OPEN'::\"StockTakeStatus\", 'SUBMITTED'::\"StockTakeStatus\"])"))
  @@index([status, openedAt])
}

/// One variant to count. Expected quantities are the units that should be on the shelf: onHand plus units sold but not
/// yet dispatched. expectedAtOpen is read when the session opens; expectedQuantity when the count is recorded, so
/// stock that moved during the count is not mistaken for a variance. variance = countedQuantity - expectedQuantity.
model StockTakeLine {
  id               String    @id @default(cuid())
  stockTakeId      String
  variantId        String
  expectedAtOpen   Int
  expectedQuantity Int?
  countedQuantity  Int?
  variance         Int?
  countedById      String?
  countedAt        DateTime?
  /// The STOCK_TAKE adjustment posted on approval (none for a zero variance)
  movementId       String?
  stockTake        StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variant          Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([stockTakeId, variantId])
  @@index([variantId])
}

/// PENDING until the next low-stock digest; SENT once listed in one; DROPPED when the variant recovered first (P4-B.2).
enum LowStockAlertStatus {
  PENDING
  SENT
  DROPPED
}

/// A variant whose available stock at a location fell to its low-stock threshold (from inventory.low_stock.v1),
/// waiting for the staff digest. At most one PENDING alert per variant and location; eventId makes a redelivered
/// event a no-op.
model LowStockAlert {
  id                String              @id @default(cuid())
  variantId         String
  locationId        String
  eventId           String              @unique
  availableAtAlert  Int
  status            LowStockAlertStatus @default(PENDING)
  /// The digest that listed it, and the available stock it showed
  digestId          String?
  availableAtDigest Int?
  createdAt         DateTime            @default(now())
  resolvedAt        DateTime?
  variant           Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location          StockLocation       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId], map: "LowStockAlert_one_pending_per_variant_location", where: raw("status = 'PENDING'::\"LowStockAlertStatus\""))
  @@index([status, createdAt])
  @@index([digestId])
  @@index([locationId])
}

enum PriceChangeField {
  PRICE
  BASE_PRICE
}

enum PriceChangeSource {
  ADMIN_EDIT
  VARIANT_CREATED
  TAX_RATE_CHANGE
  MIGRATION
}

/// Append-only price history (ADR-0005 §6): one row per changed Variant.price or basePrice, written in the same
/// transaction as the change. A trigger refuses updates and direct deletes; deleting the variant removes its rows.
model PriceChange {
  id        String            @id @default(cuid())
  variantId String
  field     PriceChangeField
  /// Null for the variant's first price
  oldValue  Decimal?          @db.Decimal(14, 2)
  newValue  Decimal           @db.Decimal(14, 2)
  currency  Currency
  source    PriceChangeSource
  reason    String?
  actorId   String?
  createdAt DateTime          @default(now())
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

/// What a promotion targets (ADR-0005 §2): one kind of target per promotion, or the whole cart.
enum PromotionScope {
  SKU
  PRODUCT
  CATEGORY
  BRAND
  CART
}

/// How a promotion reduces the price.
enum PromotionType {
  /// value is a percentage (0-100) of the price
  PERCENT
  /// value comes off each targeted unit, or off the cart
  AMOUNT_OFF
  /// each targeted unit costs value (never more than its price); not for CART
  FIXED_PRICE
  /// buy buyQuantity units of the targets, get getQuantity of the reward targets value percent off (100 = free); not for CART
  BXGY
  /// tiers by targeted quantity (item scopes) or by spend (CART); the best reached tier applies as tierValueType
  TIERED
  /// the delivery fee: waived (no value) or value off it, never below zero; CART scope, optionally limited to zones
  FREE_SHIPPING
}

/// One tier of a TIERED promotion: minimumQuantity (item scopes) or minimumSpend (CART), and its value.
model PromotionTier {
  id              String    @id @default(cuid())
  promotionId     String
  minimumQuantity Int?
  minimumSpend    Decimal?  @db.Decimal(14, 2)
  /// A percentage, an amount off or a fixed unit price, as the promotion's tierValueType says
  value           Decimal   @db.Decimal(14, 2)
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
}

/// A price reduction the pricing engine (src/pricing/price.ts) applies while it is active, in its schedule and its
/// conditions hold. With requiresCoupon, only an order that enters one of its coupon codes gets it. Targets: variants
/// for SKU, products for PRODUCT, categories for CATEGORY, brands for BRAND, none for CART.
model Promotion {
  id               String          @id @default(cuid())
  name             String
  description      String?
  scope            PromotionScope
  type             PromotionType
  /// Null for TIERED (its tiers carry the values) and for a FREE_SHIPPING promotion that waives the whole fee
  value            Decimal?        @db.Decimal(14, 2)
  /// BXGY: units of the targets to buy per application
  buyQuantity      Int?
  /// BXGY: reward units per application
  getQuantity      Int?
  /// BXGY: most applications per order; null for no limit
  maxApplications  Int?
  /// TIERED: how each tier's value reduces the price (PERCENT, AMOUNT_OFF, or FIXED_PRICE for item scopes)
  tierValueType    PromotionType?
  tiers            PromotionTier[]
  /// The order's merchandise must be worth at least this much (the engine says which subtotal)
  minimumSpend     Decimal?        @db.Decimal(14, 2)
  /// At least this many targeted units (any unit for CART) must be in the cart
  minimumQuantity  Int?
  startsAt         DateTime
  /// Open-ended when null
  endsAt           DateTime?
  isActive         Boolean         @default(false)
  /// Breaks ties between equal savings: the lowest number wins, then the oldest promotion
  priority         Int             @default(0)
  /// Within a group, per level (item or cart), only the promotion saving the most applies
  stackingGroup    String          @default("default")
  /// When it applies, no other promotion does
  exclusive        Boolean         @default(false)
  requiresCoupon   Boolean         @default(false)
  /// Orders that may use it, across all customers; null for no limit
  usageLimit       Int?
  /// Reserved redemptions: taken when an order is placed, given back on cancel or expiry before payment
  usedCount        Int             @default(0)
  /// Units that may be sold at the promotional price across all orders (a flash sale); null for no cap
  unitCap          Int?
  /// Units sold at the promotional price by orders holding a RESERVED redemption (the sum of their units)
  unitsUsed        Int             @default(0)
  /// Orders each customer may use it on; null for no limit
  perCustomerLimit Int?
  /// Only for a customer without an earlier order that reached CONFIRMED (or later) or PAYMENT_REVIEW
  firstOrderOnly   Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  variants         Variant[]       @relation("PromotionToVariant")
  products         Product[]       @relation("ProductToPromotion")
  categories       Category[]      @relation("CategoryToPromotion")
  brands           Brand[]         @relation("BrandToPromotion")
  /// BXGY reward targets, of the scope's kind; none means the targets themselves
  rewardVariants   Variant[]       @relation("PromotionRewardVariants")
  rewardProducts   Product[]       @relation("PromotionRewardProducts")
  rewardCategories Category[]      @relation("PromotionRewardCategories")
  rewardBrands     Brand[]         @relation("PromotionRewardBrands")
  /// Only for members of one of these groups; empty for everyone
  customerGroups   CustomerGroup[]
  /// FREE_SHIPPING: only for deliveries to these zones; empty for every zone
  shippingZones    ShippingZone[]
  couponCodes      CouponCode[]
  redemptions      Redemption[]

  @@index([isActive, startsAt, endsAt])
}

/// A code a customer enters at checkout to unlock its promotion; one per order.
model CouponCode {
  id          String       @id @default(cuid())
  /// Upper case (a CHECK enforces it), so codes are unique ignoring case
  code        String       @unique @db.VarChar(50)
  promotionId String
  isActive    Boolean      @default(true)
  /// Orders that may use this code; null for no limit (the promotion's limits still apply)
  usageLimit  Int?
  usedCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  promotion   Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions Redemption[]
  orders      Order[]

  @@index([promotionId])
}

enum RedemptionStatus {
  /// Counted against the limits since the order was placed
  RESERVED
  /// Given back: the order was cancelled or expired before payment
  RELEASED
}

/// One promotion used by one order (ADR-0005 §5); the limits count RESERVED rows.
model Redemption {
  id           String           @id @default(cuid())
  promotionId  String
  couponCodeId String?
  customerId   String
  orderId      String
  status       RedemptionStatus @default(RESERVED)
  /// Units the order bought at the promotional price (0 for a cart promotion); counted in Promotion.unitsUsed while RESERVED
  units        Int              @default(0)
  createdAt    DateTime         @default(now())
  releasedAt   DateTime?
  promotion    Promotion        @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  couponCode   CouponCode?      @relation(fields: [couponCodeId], references: [id], onDelete: Restrict)
  customer     User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId, orderId])
  @@index([promotionId, customerId, status])
  @@index([couponCodeId])
  @@index([customerId])
  @@index([orderId])
}

/// A named set of customers (P2-B.3). Generic: promotions and B2B price lists (P2-W) may be limited to groups.
model CustomerGroup {
  id          String                @id @default(cuid())
  name        String                @unique @db.VarChar(100)
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  members     CustomerGroupMember[]
  promotions  Promotion[]
  priceLists  PriceList[]
}

/// A customer's membership of a group.
model CustomerGroupMember {
  groupId   String
  userId    String
  createdAt DateTime      @default(now())
  group     CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

/// B2B price list (P2-W.1, ADR-0005 §7): for members of its customer groups, while active and in its schedule, its
/// entries replace their variants' normal price (the pricing engine picks the lowest across lists, never above normal).
model PriceList {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(100)
  description     String?
  /// Always the store currency (checked on write)
  currency        Currency         @default(GHS)
  isActive        Boolean          @default(false)
  /// Open from creation when null
  startsAt        DateTime?
  /// Open-ended when null
  endsAt          DateTime?
  /// Breaks ties between equal prices: the lowest number wins, then the oldest list
  priority        Int              @default(0)
  /// Promotions apply on top of this list's prices; when false its lines are left out of promotions entirely
  allowPromotions Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customerGroups  CustomerGroup[]
  entries         PriceListEntry[]

  @@index([isActive])
}

/// A variant's price in a list: `price` (tax included, like Variant.price) from minQuantity units (the MOQ); below it the
/// normal price applies. Tiers lower it for larger quantities.
model PriceListEntry {
  id          String          @id @default(cuid())
  priceListId String
  variantId   String
  price       Decimal         @db.Decimal(14, 2)
  minQuantity Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  priceList   PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant     Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tiers       PriceListTier[]

  @@unique([priceListId, variantId])
  @@index([variantId])
}

/// A quantity break of an entry: from minQuantity units (above the entry's), each unit costs price (never more than the
/// break below it).
model PriceListTier {
  id          String         @id @default(cuid())
  entryId     String
  minQuantity Int
  price       Decimal        @db.Decimal(14, 2)
  entry       PriceListEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, minQuantity])
}

enum CodBlacklistKind {
  PHONE
  GHANA_POST_GPS
  STREET_ADDRESS
}

/// A phone or delivery address refused cash on delivery (P3-B.2). `value` is the normalised form the checkout compares
/// (src/cod/cod-blacklist.ts): E.164 phone, GPS code without separators, or "street|city" in lower case.
model CodBlacklistEntry {
  id          String           @id @default(cuid())
  kind        CodBlacklistKind
  value       String
  reason      String
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@unique([kind, value])
}

/// Where a serialised unit is (P4-D.1, src/inventory/serials/serial-rules.ts): IN_STOCK on a location's shelf, ASSIGNED
/// to an order line at pick (still on the shelf), SOLD once dispatched, IN_TRANSIT on a stock transfer, WRITTEN_OFF
/// (adjusted away, or missing when a transfer was received).
enum SerialUnitStatus {
  IN_STOCK
  ASSIGNED
  SOLD
  IN_TRANSIT
  WRITTEN_OFF
}

/// One physical unit of a variant of a trackSerials product (P4-D.1). The serial is stored normalised and is unique
/// per variant. Per (variant, location), IN_STOCK + ASSIGNED units = StockLevel.onHand + units sold online whose order
/// is not dispatched yet (checked nightly by the stock reconciliation). CHECKs tie location and order line to the
/// status. Every change writes a SerialUnitEvent in the same transaction.
model SerialUnit {
  id               String            @id @default(cuid())
  variantId        String
  serial           String
  status           SerialUnitStatus  @default(IN_STOCK)
  /// Set while IN_STOCK or ASSIGNED
  locationId       String?
  /// Set while ASSIGNED or SOLD
  orderItemId      String?
  /// The shipment line the unit was picked for (P5-B.1); set while ASSIGNED or SOLD, a line of orderItemId
  shipmentItemId   String?
  receivedAt       DateTime          @default(now())
  soldAt           DateTime?
  /// Set at delivery when the product has a warranty
  warrantyStartsAt DateTime?
  warrantyEndsAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  variant          Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location         StockLocation?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orderItem        OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  shipmentItem     ShipmentItem?     @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)
  events           SerialUnitEvent[]

  @@unique([variantId, serial])
  @@index([serial])
  @@index([orderItemId])
  @@index([shipmentItemId])
  @@index([variantId, locationId, status])
}

/// Append-only history of a serial unit (P4-D.1): one row per status change, with the stock movement that went with
/// it (receipt, adjustment, transfer, return) and what caused it. Location, order line and movement are snapshots,
/// not foreign keys. A trigger refuses updates and direct deletes.
model SerialUnitEvent {
  id           String            @id @default(cuid())
  serialUnitId String
  /// Null when the unit was first received
  from         SerialUnitStatus?
  to           SerialUnitStatus
  locationId   String?
  orderItemId  String?
  movementId   String?
  refType      String?
  refId        String?
  actorId      String?
  note         String?
  createdAt    DateTime          @default(now())
  serialUnit   SerialUnit        @relation(fields: [serialUnitId], references: [id], onDelete: Cascade)

  @@index([serialUnitId, createdAt])
  @@index([refType, refId])
}

/// Who the store buys from (P4-E.1). The name is unique per store ignoring case (nameKey = trimmed, lower-cased name).
/// A supplier a purchase order refers to cannot be deleted, only deactivated (no new purchase orders).
model Supplier {
  id             String          @id @default(cuid())
  storeId        String
  name           String          @db.VarChar(200)
  nameKey        String          @db.VarChar(200)
  contactName    String?         @db.VarChar(200)
  phone          String?         @db.VarChar(50)
  email          String?         @db.VarChar(320)
  address        String?         @db.VarChar(1000)
  notes          String?         @db.VarChar(2000)
  /// The currency the supplier is paid in; only the store currency for now
  currency       Currency
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, nameKey])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// Goods ordered from a supplier for one stock location (P4-E.1). Lines change only in DRAFT; receipts add stock at
/// the location (RECEIPT movements, refType PurchaseOrder) and update the weighted-average cost. Status changes are
/// conditional updates through the pure table in src/purchasing/purchase-orders/purchase-order-status.ts.
model PurchaseOrder {
  id            String                 @id @default(cuid())
  /// Shown as the reference "PO-00042"; a sequence, so a rolled-back creation leaves a gap
  number        Int                    @unique @default(autoincrement())
  supplierId    String
  locationId    String
  status        PurchaseOrderStatus    @default(DRAFT)
  currency      Currency
  expectedAt    DateTime?
  note          String?                @db.VarChar(1000)
  createdById   String
  sentById      String?
  sentAt        DateTime?
  closedById    String?
  closedAt      DateTime?
  closeReason   String?                @db.VarChar(500)
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?                @db.VarChar(500)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  supplier      Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location      StockLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  receipts      PurchaseOrderReceipt[]

  @@index([status, createdAt])
  @@index([supplierId])
  @@index([locationId])
  @@index([createdAt])
}

/// One variant on a purchase order: units ordered at a tax-exclusive unit cost, and units received so far
/// (CHECK 0 <= quantityReceived <= quantityOrdered).
model PurchaseOrderLine {
  id               String                     @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  unitCost         Decimal                    @db.Decimal(14, 4)
  quantityReceived Int                        @default(0)
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          Variant                    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  receiptLines     PurchaseOrderReceiptLine[]

  @@unique([purchaseOrderId, variantId])
  @@index([variantId])
}

/// One delivery received against a purchase order (P4-E.1); a purchase order may have several.
model PurchaseOrderReceipt {
  id              String                     @id @default(cuid())
  purchaseOrderId String
  receivedById    String
  receivedAt      DateTime                   @default(now())
  note            String?                    @db.VarChar(500)
  purchaseOrder   PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines           PurchaseOrderReceiptLine[]

  @@index([purchaseOrderId])
}

/// Units of one purchase-order line in a receipt, at the line's unit cost, with the lot they went into (lot-tracked
/// variants) and the first stock movement written for them.
model PurchaseOrderReceiptLine {
  id         String               @id @default(cuid())
  receiptId  String
  lineId     String
  quantity   Int
  unitCost   Decimal              @db.Decimal(14, 4)
  lotId      String?
  movementId String
  receipt    PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  line       PurchaseOrderLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lot        Lot?                 @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([receiptId, lineId])
  @@index([lineId])
  @@index([lotId])
}

enum CostChangeSource {
  PURCHASE_ORDER
  MANUAL
}

/// Every change of Variant.costPrice (P4-E.1), append-only (a trigger refuses updates and direct deletes; deleting
/// the variant removes its rows). refType/refId name what caused it, e.g. ("PurchaseOrderReceipt", receiptId).
model CostChange {
  id        String           @id @default(cuid())
  variantId String
  /// Null when the cost was unknown before
  oldValue  Decimal?         @db.Decimal(14, 4)
  newValue  Decimal          @db.Decimal(14, 4)
  currency  Currency
  source    CostChangeSource
  refType   String?
  refId     String?
  reason    String?          @db.VarChar(500)
  actorId   String?
  createdAt DateTime         @default(now())
  variant   Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}
