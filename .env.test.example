# DATABASE_URL's database name must end in _test or e2e setup refuses to run.
NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emma_commerce_test?schema=public

JWT_SECRET=test-only-jwt-secret-change-me-0000000000
JWT_REFRESH_SECRET=test-only-jwt-refresh-secret-change-me-0000
JWT_RESET_SECRET=test-only-jwt-reset-secret-change-me-00000
JWT_TOKEN_AUDIENCE=localhost:3000
JWT_TOKEN_ISSUER=localhost:3000

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
FACEBOOK_APP_ID=test-facebook-app-id
FACEBOOK_APP_SECRET=test-facebook-app-secret
PAYSTACK_SECRET_KEY=sk_test_fake_placeholder
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-cloudinary-key
CLOUDINARY_API_SECRET=test-cloudinary-secret

SUPER_ADMIN_EMAIL=superadmin@example.test
SUPER_ADMIN_PASSWORD=test-only-password-change-me
