{
  "name": "emma-commerce-backend",
  "version": "0.0.1",
  "description": "",
  "author": "emmanuel oppong junior",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:demo": "ts-node --transpile-only prisma/seeders/demo-electronics.ts",
    "start:worker": "node dist/main --role=worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit:prod": "node scripts/check-prod-audit.js",
    "schema:generate": "ts-node --transpile-only scripts/generate-schema.ts",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:repro": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config ./test/jest-repro.json"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@keyv/redis": "^5.1.6",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/cache-manager": "^12.0.5",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-prometheus": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nestjs": "^11.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.15.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-query-complexity": "^2.0.0",
    "graphql-type-json": "^0.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.3.2",
    "keyv": "^5.6.0",
    "read-excel-file": "^9.3.20",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@graphql-inspector/cli": "^7.0.5",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^12.5.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../test/helpers"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
