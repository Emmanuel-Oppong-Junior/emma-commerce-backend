{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.(e2e-spec|e2e\\.spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "setupFiles": ["<rootDir>/setup.ts"],
  "testTimeout": 60000,
  "forceExit": true,
  "verbose": true,
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "1GB"
}
